{
  "sourceLanguage": "tr",
  "strings": {
    "${applicationName} zamanlayıcı başlat": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a ${applicationName} timer"
          }
        }
      }
    },
    "${applicationName} ile geri sayım başlat": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a countdown with ${applicationName}"
          }
        }
      }
    },
    "${applicationName} not ekle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a ${applicationName} note"
          }
        }
      }
    },
    "${applicationName} ile not al": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a note with ${applicationName}"
          }
        }
      }
    },
    "${applicationName} profil çalıştır": {
