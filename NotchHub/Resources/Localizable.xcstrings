    },
    "Yalnızca Pomodoro odak aşaması sürerken etkindir; ilk %lld saniye yok sayılır.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Active only during a Pomodoro focus phase; the first %lld second is ignored."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Active only during a Pomodoro focus phase; the first %lld seconds are ignored."
