      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset Data…"
          }
        }
      }
    },
    "Web URL'sinde ana makine yok": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Web URL has no host"
          }
        }
      }
    },
    "Web'de Outlook › Ayarlar › Takvim › Paylaşılan takvimler › Takvim yayınla, ardından ICS bağlantısını kopyalayın. Herhangi bir https:// veya webcal:// akışı çalışır. Bağlantı okuma erişimi verdiği için Anahtar Zinciri'nde saklanır.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Outlook on the web, go to Settings › Calendar › Shared calendars › Publish a calendar, then copy the ICS link. Any https:// or webcal:// feed works. Because the link grants read access, it's stored in the Keychain."
          }
        }
      }
    },
    "Web/URL üzerinden uyarılara izin ver": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Alerts via Web/URL"
          }
        }
      }
    },
