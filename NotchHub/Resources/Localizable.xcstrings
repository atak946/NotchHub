    "Yalnızca eşleşen müşteri ve uygulama saklanır; pencere başlıkları veya yollar asla saklanmaz.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the matched client and app are stored; window titles and paths are never stored."
