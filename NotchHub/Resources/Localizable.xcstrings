{
  "sourceLanguage": "tr",
  "strings": {
    " %@ soketleri root olmadan okunamaz; işlem algılama kullanılıyor.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " %@ sockets can't be read without root; using process detection instead."
          }
        }
      }
    },
    " Bu oturum konsolda değil.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " This session isn't on the console."
          }
        }
      }
    },
    " Sınırlı mod: %@ bağlantıları root olmadan okunamaz, bu yüzden yalnızca çalışan işlem algılanır.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Limited mode: %@ connections can't be read without root, so only the running process is detected."
          }
        }
      }
    },
    "${minutes} dakikalık zamanlayıcı başlat": {
