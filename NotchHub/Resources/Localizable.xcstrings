    "%@. %lld sn veya daha uzun süren komutlar çentikte uyarı gösterir; değiştirmek için %@ kullanın. %lld sn içinde en fazla %lld uyarı; URL üzerinden dakikada en fazla %lld uyarı.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Commands that take %lld s or longer show an alert in the notch; use %@ to change this. Within %lld s, at most %lld alerts; via URL, at most %lld alerts per minute."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@. %2$lld sn veya daha uzun süren komutlar çentikte uyarı gösterir; değiştirmek için %3$@ kullanın. %4$lld sn içinde en fazla %5$lld uyarı; URL üzerinden dakikada en fazla %6$lld uyarı."
          }
        }
      }
    },
