    "NSAppleEventsUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchHub controls Spotify and Music playback from the notch."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchHub, Spotify ve Music oynatmasını çentikten denetler."
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchHub shows your next meeting in the notch."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchHub bir sonraki toplantını çentikte gösterir."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchHub shows a quick mirror preview in the notch so you can check your camera before a meeting."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchHub, toplantı öncesi kameranı kontrol etmen için çentikte kısa bir ayna önizlemesi gösterir."
          }
        }
      }
    },
    "NSLocationUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchHub, çentikte bulunduğun yerin hava durumunu göstermek için yaklaşık konumunu kullanır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchHub uses your approximate location to show the weather where you are in the notch."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
