// Copy to Config/Local.xcconfig (gitignored) and fill in your own values.

APP_BUNDLE_ID = com.example.NotchHub
DEVELOPMENT_TEAM = ABCDE12345
CODE_SIGN_IDENTITY = Apple Development
CODE_SIGN_IDENTITY[config=Release] = Developer ID Application
OTHER_CODE_SIGN_FLAGS[config=Release] = --timestamp

// Published releases only: https://github.com/<owner>/<repo>/releases/latest/download/appcast.xml
SU_FEED_URL =
// Output of Sparkle's generate_keys.
SU_PUBLIC_ED_KEY =

// GitHub repo for "Sorun bildir" (owner/repo); empty only copies the report.
NH_ISSUE_URL =
