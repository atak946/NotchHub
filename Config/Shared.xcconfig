// Public build defaults. Owner-specific values (bundle id, team, signing, update feed)
// go in Config/Local.xcconfig, which is gitignored. See Config/Local.xcconfig.example.

APP_BUNDLE_ID = dev.notchhub.NotchHub
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
OTHER_CODE_SIGN_FLAGS =

// Sparkle update feed and EdDSA public key; empty disables update checks.
SU_FEED_URL =
SU_PUBLIC_ED_KEY =

#include? "Local.xcconfig"
